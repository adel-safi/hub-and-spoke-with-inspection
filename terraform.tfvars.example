region   = "us-east-1"
name     = "hns"
az_count = 2

hub_cidr = "10.0.0.0/16"

spokes = {
  spoke-a = { cidr = "10.1.0.0/16" }
  spoke-b = { cidr = "10.2.0.0/16" }
}

allowed_egress_domains = [
  "amazonaws.com",
  "amazon.com",
  "github.com",
]

east_west_tcp_ports   = [22, 80, 443]
create_test_instances = true
